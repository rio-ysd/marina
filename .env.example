ANTHROPIC_MODEL=anthropic.claude-sonnet-5
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
MORNING_DIGEST_SLACK_CHANNEL=

# Claude API呼び出し用のAmazon Bedrock設定。認証はLambda実行ロール等、
# 標準のAWSクレデンシャルチェーン(SigV4)を使用します。
# ローカル実行時は AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY を設定してください
# (Lambda上では実行ロールが自動的に使われるため不要です)。
BEDROCK_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Gmail連携(Google Workspaceサービスアカウント + ドメイン委任)。未設定の場合はモッククライアントで動作します。
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATED_USER=

# MoneyForwardクラウド会計 請求書/見積書API。未設定の場合はモッククライアントで動作します。
MF_CLIENT_ID=
MF_CLIENT_SECRET=

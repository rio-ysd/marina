ANTHROPIC_MODEL=anthropic.claude-sonnet-5
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
MORNING_DIGEST_SLACK_CHANNEL=

# 代理返信フロー(対象ユーザー宛のメンションに返信案を作成し、DMでYes/No確認後に本人として投稿)。
# SLACK_USER_OAUTH_TOKEN と PROXY_REPLY_TARGET_USER_ID の両方が設定されている場合のみ有効になります。
# SLACK_USER_OAUTH_TOKEN は対象ユーザー本人が認可したUser OAuthトークン(xoxp-、chat:writeスコープ必須)で、
# PROXY_REPLY_TARGET_USER_ID はそのユーザーのSlackユーザーID(例: U05RNEMF1CZ)です。
# PROXY_REPLY_CHANNEL_IDS は対象チャンネルIDのカンマ区切り許可リスト。空の場合はBotが参加している全チャンネルが対象です(DMには影響しません)。
# PROXY_REPLY_INCLUDE_DM=true で本人へのDMも代理返信の対象にします(既定: true)。
# DMを対象にするには SLACK_USER_OAUTH_TOKEN に im:history スコープが必要で、
# marinaが本人の全DMを受信する構成になる点に注意してください。falseにするとDMは一切扱いません。
SLACK_USER_OAUTH_TOKEN=
PROXY_REPLY_TARGET_USER_ID=
PROXY_REPLY_CHANNEL_IDS=
PROXY_REPLY_INCLUDE_DM=true

# Socket Mode(cmd/socketmode)で受信する場合のApp-Level Token(xapp-、スコープconnections:write)。
# Socket Modeでは公開URL(Request URL)が不要なため、ローカル検証でngrokを立てずに済みます。
# HTTP受信(cmd/server, cmd/lambda)しか使わない場合は未設定でかまいません。
SLACK_APP_TOKEN=

# 応答生成中であることを示すために、ユーザーの発言へ付けるリアクション名(既定: typing-indicator)。
# 生成完了後に自動で外します。Botトークンに reactions:write スコープが必要です。
# ワークスペースに存在しない絵文字を指定すると invalid_name で失敗します(応答自体は続行)。
# off または none を指定すると付けません。
SLACK_TYPING_EMOJI=typing-indicator

# Claude API呼び出し用のAmazon Bedrock設定。認証はLambda実行ロール等、
# 標準のAWSクレデンシャルチェーン(SigV4)を使用します。
# ローカル実行時は AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY を設定してください
# (Lambda上では実行ロールが自動的に使われるため不要です)。
BEDROCK_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Google連携(Gmail / カレンダー / Drive / スプレッドシート / People / Admin SDK)。
# Google Workspaceサービスアカウント + ドメイン委任で、すべて同じ認証情報を使います。
# 未設定の場合はいずれもモッククライアントで動作します。
# ドメイン委任の許可スコープには以下すべてを登録してください(入力内容で置き換わるため部分指定は不可)。
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/gmail.modify
#   https://www.googleapis.com/auth/gmail.compose
#   https://www.googleapis.com/auth/calendar
#   https://www.googleapis.com/auth/drive
#   https://www.googleapis.com/auth/spreadsheets
#   https://www.googleapis.com/auth/directory.readonly
#   https://www.googleapis.com/auth/contacts.readonly
#   https://www.googleapis.com/auth/admin.directory.user
# スコープ未登録なら unauthorized_client、Google CloudコンソールでのAPI有効化漏れなら
# 403 SERVICE_DISABLED で失敗します(別の原因なのでエラー文で切り分けてください)。
# 詳細は docs/google-drive.md / docs/google-calendar.md / docs/google-sheets.md /
# docs/google-people.md / docs/google-user-provisioning.md を参照してください。
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATED_USER=

# Google Workspaceアカウント作成の承認者のSlackユーザーID(例: U05RNEMF1CZ)。
# 未設定の場合はアカウント作成の依頼ツール自体を登録しません(Claudeは作成を試みることすらできません)。
# 設定すると、Slackからの作成依頼がこのユーザーへのYes/No確認DMになり、Yesを押して初めて作成されます。
# 承認できるのはこのユーザーのみで、他の人がボタンを押しても無視されます。
# 別途、代理対象ユーザー(GOOGLE_IMPERSONATED_USER)にユーザー管理権限が必要です。
# 詳細は docs/google-user-provisioning.md を参照してください。
USER_PROVISION_APPROVER_SLACK_USER_ID=

# Slack App Homeのホームタブから「追加の運用ルール」を編集できるSlackユーザーID(例: U05RNEMF1CZ)。
# ここに書いた指示は、Slackでの応答と朝のメールダイジェストの両方のプロンプトに差し込まれます
# (例: 「SALON BOARD関連のメールは重要ではないので、既読にするだけでよい」)。
# 未設定の場合、ホームタブは閲覧のみになります(誰にも編集ボタンが出ません)。
# Slack App側で App Home の Home Tab 有効化と、app_home_opened イベントの購読が必要です。
# 詳細は docs/app-home.md を参照してください。
HOME_ADMIN_SLACK_USER_ID=

# MoneyForwardクラウド請求書API(OAuth2)。いずれも未設定の場合はモッククライアントで動作します。
# 初回のみ https://<公開ドメイン>/mf/oauth/start にブラウザでアクセスして認可が必要です
# (以降はrefresh_tokenで自動更新されます)。MF_OAUTH_REDIRECT_URIはMoneyForwardアプリポータルに
# 登録したリダイレクトURI(https://<公開ドメイン>/mf/oauth/callback)と一致させてください。
MF_CLIENT_ID=
MF_CLIENT_SECRET=
MF_OAUTH_REDIRECT_URI=
